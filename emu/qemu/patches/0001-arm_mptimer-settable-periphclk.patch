 /* State of a single timer or watchdog block */
 typedef struct {
     uint32_t control;
+    uint32_t ios3ds_hz;     /* ios3ds: PERIPHCLK this timer's rate was last set for (0 = default) */
     uint32_t status;
     struct ptimer_state *timer;
     qemu_irq irq;
